const uint8 XR_TON_X1[]  = {
    23, 27, 31, 35, 40, 44, 46, 48, 52, 60, 62, 64, 67, 70, 72, 76, 84, 87, 92, 96, 99, 104, 22, 24,
    26, 28, 30, 32, 34, 36, 39, 43, 46, 48, 50, 58, 62, 64, 66, 68, 70, 72, 74, 82, 86, 88, 90, 95,
