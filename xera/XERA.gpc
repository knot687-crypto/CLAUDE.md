// tagline "CURVE ENGINE OFF"
const uint8 XR_TOFF_ROW[] = { 0, 16, 36, 56, 77, 94 };
const uint8 XR_TOFF_X0[]  = {
    32, 36, 38, 40, 44, 46, 48, 56, 60, 64, 68, 72, 76, 84, 88, 92, 32, 36, 38, 40, 42, 44, 46, 48,
    56, 60, 62, 64, 69, 72, 74, 76, 84, 86, 88, 92, 32, 36, 38, 40, 44, 46, 48, 56, 60, 62, 64, 66,
    69, 72, 74, 76, 84, 86, 88, 92, 32, 36, 38, 40, 42, 44, 46, 48, 56, 60, 62, 64, 66, 69, 72, 74,
    76, 84, 86, 88, 92, 32, 36, 40, 42, 45, 48, 56, 60, 62, 64, 68, 72, 74, 76, 84, 88, 92
};
