    23, 26, 31, 34, 38, 42, 46, 48, 50, 58, 62, 64, 66, 70, 72, 74, 82, 86, 90, 94, 98, 102, 22, 24,
    26, 28, 30, 32, 34, 36, 39, 43, 46, 48, 50, 58, 62, 64, 66, 68, 70, 72, 74, 82, 86, 88, 90, 95,
    98, 100, 102, 22, 26, 28, 30, 34, 39, 43, 46, 48, 50, 58, 62, 64, 66, 70, 72, 74, 82, 86, 88, 90,
    92, 95, 98, 100, 102, 22, 24, 26, 28, 30, 32, 34, 39, 43, 46, 48, 50, 58, 62, 64, 66, 68, 70, 72,
    74, 82, 86, 88, 90, 92, 95, 98, 100, 102, 22, 24, 26, 30, 32, 34, 39, 42, 47, 50, 58, 62, 66, 68,
    71, 74, 82, 86, 88, 90, 94, 98, 100, 102
