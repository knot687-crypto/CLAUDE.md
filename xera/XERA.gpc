/* ===========================================================================
 *
 *      ##   ##  #######  ######    #####
 *       ## ##   ##       ##   ##  ##   ##
 *        ###    #####    ######   #######
 *       ## ##   ##       ##  ##   ##   ##
 *      ##   ##  #######  ##   ##  ##   ##
 *
 *      XERA  -  Adaptive Curve Engine            for Cronus Zen  (GPC, 32-bit)
 *
 * ---------------------------------------------------------------------------
 *  WHAT IT DOES
 *    Every 1 ms XERA reads your aim stick and works out how it is moving:
 *    where it is, how fast, which direction, outward or inward, and whether
 *    you are micro-aiming, tracking or flicking. It then searches a library of
 *    32,768 response curves for the one that best fits that exact moment,
 *    glides to it without a bump, and repeats on the next millisecond.
 *
 *  THE CURVE LIBRARY  (never linear, never expo)
 *    Every curve is a dual-rational S-curve: a convex precision zone and a
 *    concave speed zone joined at a knee p with matched slope (C1-smooth):
 *        f(t) = q * B(t/p ; a)                      for t <  p
 *        f(t) = q + (1-q) * B((t-p)/(1-p) ; b)      for t >= p
 *        B(u ; s) = u / ((1/s - 2) * (1 - u) + 1)
 *    32 knee positions x 32 precision depths x 32 knee drives = 32,768 curves.
 *    Each curve is strictly monotone, has a true inflection point, and its
 *    knee gain is always at least 2.25x its centre gain and 1.56x its top gain.
 *    So no curve in the library is linear, and none bends only one way like expo.
 *
 *  HOW THE SEARCH WORKS  (every 1 ms)
 *    1. An alpha-beta tracking filter estimates stick velocity at 1 kHz.
 *    2. Fuzzy intent: PRECISION (slow and near centre), TRACKING, and FLICK
 *       (fast and outward), blended smoothly with smoothstep memberships.
 *    3. Cost of a curve = gain error at your stick position
 *                       + predicted-path error 24 ms ahead (flicks)
 *                       + distance from the intent's home shape.
 *    4. A compass (pattern) search scores 6 neighbours plus the intent's home
 *       curve each tick, halving its step until it locks on. Tested against
 *       an exhaustive scan of all 32,768 curves, it lands on the same curve
 *       98.5% of the time, usually within 4 ms.
 *    5. The winner is blended in through a critically damped two-stage glide.
 *       The glide is fast while you flick and slow while you hold, so the
 *       curve never jumps under your thumb.
 *    6. The curve is applied radially, so your aim direction is preserved.
 *       The output is rounded to the nearest unit, or stochastically rounded
 *       when XR_DITHER is 1.
 *
 *  BUILT FROM: bit-packed state (BVARS), unsigned lookup maps (UMAPS) and
 *  functions only. There are no combos.
 *
 *  CONTROLS
 *    Hold L2/LT and tap SHARE/VIEW  ->  XERA engine ON / OFF (tagline shows it)
 *
 *  SETUP TIPS
 *    - Set the in-game response curve to LINEAR (or the flattest option) and
 *      the in-game deadzone as low as it goes. XERA supplies both.
 *    - Raise XR_DEADZONE only if your stick drifts. If the game forces a
 *      deadzone, set XR_ANTI_DZ to roughly the same percent.
 *    - In Zen Studio, keep the Zen's CPU load under about 80%. If it is high,
 *      lower XR_PROBES. A built-in governor also backs off by itself
 *      whenever a 1 ms tick runs long.
 * ======================================================================== */

// ============================ USER SETTINGS =================================
define XR_AIM_X        = PS4_RX;     // aim stick X (identical to XB1_RX)
define XR_AIM_Y        = PS4_RY;     // aim stick Y (identical to XB1_RY)
define XR_DEADZONE     = 4;          // inner deadzone, stick %   (0 - 20)
define XR_ANTI_DZ      = 0;          // anti-deadzone, output %   (0 - 30)
define XR_OUTER        = 100;        // stick % treated as full deflection (90 - 100)
define XR_GAIN_PREC    = 65;         // local gain while micro-aiming   (% of 1:1)
define XR_GAIN_TRACK   = 100;        // local gain while tracking       (% of 1:1)
define XR_GAIN_FLICK   = 190;        // local gain while flicking       (% of 1:1)
define XR_TOGGLE_HOLD  = PS4_L2;     // hold this ...
define XR_TOGGLE_TAP   = PS4_SHARE;  // ... and tap this to toggle the engine
define XR_START_ON     = 1;          // 1 = engine ON when the script loads
define XR_DITHER       = 0;          // 1 = stochastic rounding (sub-1% precision)
define XR_PROBES       = 6;          // neighbour curves scored per ms (2 - 6)

// ============================ ENGINE CONSTANTS ==============================
// Fixed point: Q12 -> 4096 = 1.0.  Speeds in Q12 stick-units per ms.
define XR_VM_MS     = 1;     // target VM tick (vm_tctrl(-9) = 1 ms)
define XR_ALPHA     = 1024;  // alpha-beta filter: position gain   0.250
define XR_BETA      = 110;   // alpha-beta filter: velocity gain   0.027
define XR_FAST_LO   = 1843;  // flick speed window   0.45 .. 1.30 units/ms
define XR_FAST_HI   = 5325;
define XR_OUT_LO    = 614;   // outward ratio window 0.15 .. 0.75
define XR_OUT_HI    = 3072;
define XR_SLOW_LO   = 287;   // precision speed window 0.07 .. 0.22 units/ms
define XR_SLOW_HI   = 901;
define XR_NEAR_LO   = 410;   // precision deflection window 0.10 .. 0.42
define XR_NEAR_HI   = 1720;
define XR_SM_RATE   = 24;    // speed memory (ms)
define XR_F_ATK     = 4;     // flick intent attack (ms)
define XR_F_REL     = 6;     // flick intent release (ms)
define XR_P_RATE    = 16;    // precision intent rate (ms)
define XR_FENV_REL  = 96;    // post-flick envelope release (ms)
define XR_W2P       = 10;    // gain-error weight: precision
define XR_W2T       = 0;     // gain-error weight: tracking (stable home shape)
define XR_W2F       = 8;     // gain-error weight: flick
define XR_TAU       = 24;    // flick path prediction horizon (ms)
define XR_W3_MAX    = 24;    // predicted-path weight at full flick
define XR_W4        = 2;     // home-shape (Tikhonov) weight
define XR_GL_SLOW   = 16;    // glide divisor at rest (ms)
define XR_GL_FAST   = 3;     // glide divisor while flicking (ms)
// intent home curves, lattice coordinates in Q4 (index * 16)
define XR_HP_P      = 248;   // precision home: knee
define XR_HP_A      = 271;   //                 depth
define XR_HP_K      = 109;   //                 drive
define XR_HT_P      = 191;   // tracking home:  knee
define XR_HT_A      = 406;   //                 depth
define XR_HT_K      = 62;    //                 drive
define XR_HF_P      = 76;    // flick home:     knee
define XR_HF_A      = 361;   //                 depth
define XR_HF_K      = 388;   //                 drive

// BVAR bit map (xr_flags)
define XR_B_ON    = 0;       // engine enabled
define XR_B_LOCK  = 1;       // search locked on the optimum
define XR_B_TAG   = 2;       // tagline needs repaint
define XR_B_BOOT  = 3;       // boot animation finished

// ============================ DISPLAY CONSTANTS =============================
define XR_LX      = 15;      // logo left
define XR_LY      = 12;      // logo top
define XR_LW      = 97;      // logo width
define XR_LH      = 22;      // logo height
define XR_DIV_Y   = 41;      // divider row
define XR_TAG_Y   = 47;      // tagline top row
define XR_DIA_X   = 63;      // divider diamond centre
define XR_BW      = 7;       // flash band width
define XR_TW      = 6;       // flash trail width
define XR_HX0     = -11;     // flash start (logo x)
define XR_HX1     = 109;     // flash end   (logo x)
define XR_SWEEP   = 960;     // flash sweep time (ms)
define XR_STEP    = 24;      // flash frame time (ms)
define XR_CYCLE   = 3200;    // full animation cycle (ms)
define XR_SPK_X   = 111;     // sparkle centre
define XR_SPK_Y   = 7;
define XR_ROWS_TK = 3;       // flash rows drawn per ms (keeps every tick light)

// ============================ UMAPS (const lookup maps) =====================
// curve lattice: knee position p, precision depth A = (1-a)/a, knee drive K, 1/K  (Q12)
