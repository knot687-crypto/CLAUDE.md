--!strict
--[[
	ClipBuilder
	-----------
	Pose-to-pose authoring helpers. Poses are tables of joint -> {rx, ry, rz, px?, py?, pz?}
	(degrees / studs, Motor6D.Transform space). Clips are lists of timed keyposes; every joint
	mentioned in a keypose gets a key at that time, and joints interpolate independently through
	their own keys with auto-clamped cubic splines (see Clip).

	cycle{} builds symmetric locomotion loops from the first half of a cycle: the second half is
	generated by mirroring each keypose left<->right, so gaits are perfectly balanced.
]]

local ClipBuilder = {}

export type JointValues = { number }
export type PoseTable = { [string]: JointValues }
export type KeyDef = { any } -- { t, pose, ease = "flat"|"linear"|"step"? }

local function swapSide(name: string): string
	if name:sub(1, 4) == "Left" then
		return "Right" .. name:sub(5)
	elseif name:sub(1, 5) == "Right" then
		return "Left" .. name:sub(6)
	end
	return name
end
ClipBuilder.swapSide = swapSide

-- Mirror a pose left <-> right: (rx, ry, rz, px, py, pz) -> (rx, -ry, -rz, -px, py, pz)
function ClipBuilder.mirror(pose: PoseTable): PoseTable
	local out: PoseTable = {}
	for joint, v in pose do
		local px = v[4]
		out[swapSide(joint)] = {
			v[1] or 0,
			-(v[2] or 0),
			-(v[3] or 0),
			if px then -px else nil,
			v[5],
			v[6],
		} :: any
	end
	return out
end

-- Shallow merge: later poses override earlier joint entries.
function ClipBuilder.merge(...: PoseTable): PoseTable
	local out: PoseTable = {}
	for i = 1, select("#", ...) do
		local p = select(i, ...)
		if p then
			for k, v in p do
				out[k] = v
			end
		end
	end
	return out
end

-- Adds channel deltas to a pose (missing joints start from zero).
function ClipBuilder.add(pose: PoseTable, deltas: PoseTable): PoseTable
	local out: PoseTable = table.clone(pose)
	for joint, d in deltas do
		local base = out[joint] or { 0, 0, 0 }
		local v = {}
		for c = 1, 6 do
			local a, b = base[c], d[c]
			if a or b then
				v[c] = (a or 0) + (b or 0)
			end
		end
		out[joint] = v
	end
	return out
end

-- Linear blend between two pose tables (per channel).
function ClipBuilder.lerp(a: PoseTable, b: PoseTable, t: number): PoseTable
	local out: PoseTable = {}
	local joints = {}
	for k in a do
		joints[k] = true
	end
	for k in b do
		joints[k] = true
	end
	for joint in joints do
		local va, vb = a[joint] or { 0, 0, 0 }, b[joint] or { 0, 0, 0 }
		local v = {}
		for c = 1, 6 do
			local x, y = va[c], vb[c]
			if x or y then
				v[c] = (x or 0) + ((y or 0) - (x or 0)) * t
			end
		end
		out[joint] = v
	end
	return out
end

-- Copies a pose's arm/leg channels from one side to the other (handy for symmetric poses).
function ClipBuilder.symmetric(pose: PoseTable, fromSide: string): PoseTable
	local out: PoseTable = table.clone(pose)
	for joint, v in pose do
		if joint:sub(1, #fromSide) == fromSide then
			local m = ClipBuilder.mirror({ [joint] = v })
			for k, mv in m do
				out[k] = mv
			end
		end
	end
	return out
end

local function addKeys(tracks: { [string]: { any } }, t: number, pose: PoseTable, ease: string?)
	for joint, v in pose do
		local list = tracks[joint]
		if not list then
			list = {}
			tracks[joint] = list
		end
		table.insert(list, { t, v[1] or 0, v[2] or 0, v[3] or 0, v[4], v[5], v[6], ease })
	end
end

export type ClipDef = {
	name: string,
	length: number,
	loop: boolean?,
	keys: { KeyDef },
	hands: { [string]: { { any } } }?,
	events: { { any } }?,
	speed: number?,
	meta: { [string]: any }?,
}

function ClipBuilder.clip(def: ClipDef): any
	local tracks = {}
	for _, k in def.keys do
		addKeys(tracks, k[1], k[2], (k :: any).ease)
	end
	return {
		name = def.name,
		length = def.length,
		loop = def.loop,
		tracks = tracks,
		hands = def.hands,
		events = def.events,
		speed = def.speed,
		meta = def.meta,
	}
end

export type CycleDef = {
	name: string,
	length: number,
	half: { KeyDef }, -- keys covering [0, length/2)
	hands: { [string]: { { any } } }?,
	events: { { any } }?,
	speed: number?,
	meta: { [string]: any }?,
}

-- Symmetric loop: second half = mirrored first half shifted by length/2.
function ClipBuilder.cycle(def: CycleDef): any
	local tracks = {}
	local halfLen = def.length / 2
	for _, k in def.half do
		addKeys(tracks, k[1], k[2], (k :: any).ease)
		addKeys(tracks, k[1] + halfLen, ClipBuilder.mirror(k[2]), (k :: any).ease)
	end
	return {
		name = def.name,
		length = def.length,
		loop = true,
		tracks = tracks,
		hands = def.hands,
		events = def.events,
		speed = def.speed,
		meta = def.meta,
	}
end

-- Loop from explicit keys (not mirrored); the first key is re-used at the end automatically.
function ClipBuilder.loop(def: ClipDef): any
	local c = ClipBuilder.clip(def)
	c.loop = true
	return c
end

return ClipBuilder
